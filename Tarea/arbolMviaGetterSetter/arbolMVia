if __name__ == "__main__":
    arbol = ArbolMVias(4)

    # Insertar datos
    arbol.insertar(50)
    arbol.insertar(30)
    arbol.insertar(70)
    arbol.insertar(20)
    arbol.insertar(40)
    arbol.insertar(60)
    arbol.insertar(80)

    # Mostrar recorrido
    print("Recorrido Inorden:")
    arbol.inorden()